DATABASE_URL=file:/absolute/path/jobs.db
# Optional for collection; required when using --notify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Existing marketplace preferences and Telegram retry controls.
# CRON_EXPR="*/5 * * * *"
# ENABLE_TECH_FILTER=true
# ADDITIONAL_TECH_KEYWORDS_EN="rust,golang"
# ADDITIONAL_TECH_KEYWORDS_AR="سوليديتي"
# MOSTAQL_SCRAPE_URL="https://mostaql.com/projects?sort=latest"
# KHAMSAT_SCRAPE_URL="https://khamsat.com/community/requests"
# TELEGRAM_MIN_DELAY_MS=3100
# TELEGRAM_MAX_ATTEMPTS=5

# Website collectors are opt-in. Start with a collection-only run.
INDEED_ENABLED=false
LINKEDIN_ENABLED=false
WUZZUF_ENABLED=false
FORASNA_ENABLED=false
BAYT_ENABLED=false
WELLFOUND_ENABLED=false
INDEED_SEARCH_URL=https://eg.indeed.com/jobs?q=software&l=Egypt&sort=date
LINKEDIN_SEARCH_URL=https://www.linkedin.com/jobs/search/?keywords=software&location=Egypt&sortBy=DD&start=0
WUZZUF_SEARCH_URL=https://wuzzuf.net/search/jobs?q=software&start=0
FORASNA_SEARCH_URL=https://forasna.com/
BAYT_SEARCH_URL=https://www.bayt.com/en/egypt/jobs/
WELLFOUND_SEARCH_URL=https://wellfound.com/jobs
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_SESSION_TIMEOUT_MS=600000
# Optional; otherwise use the Playwright-installed Chromium.
# BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome
# INDEED_PROFILE_DIR=/private/path/indeed-profile
# LINKEDIN_PROFILE_DIR=/private/path/linkedin-profile
# WUZZUF_PROFILE_DIR=/private/path/wuzzuf-profile
# BROWSER_SNAPSHOT_DIR=/private/path/browser-snapshots
INDEED_MAX_PAGES=1
INDEED_MAX_DETAILS=10
LINKEDIN_MAX_PAGES=4
LINKEDIN_MAX_DETAILS=100
WUZZUF_MAX_PAGES=20
FORASNA_MAX_PAGES=5
BAYT_MAX_PAGES=5
WELLFOUND_MAX_PAGES=5
# *_MAX_DETAILS defaults to 100 outside Indeed.
