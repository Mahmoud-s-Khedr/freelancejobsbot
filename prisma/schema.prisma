generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model JobPost {
  id          Int       @id @default(autoincrement())
  source      String
  sourceProjectId String
  title       String
  url         String    @unique
  description String?
  rawText     String?
  category    String?
  status      String?
  publishedAt DateTime?
  budgetMin   Int?
  budgetMax   Int?
  budgetText  String?
  durationText String?
  skills      String?
  lastSeenAt  DateTime?
  contentHash String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([source, sourceProjectId])
  @@index([source])
  @@index([sentAt])
  @@index([lastSeenAt])
}
