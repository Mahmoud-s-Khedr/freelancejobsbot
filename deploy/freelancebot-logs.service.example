[Unit]
Description=Freelancebot persistent rotated debug logs

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/freelancebot
Environment=LOG_DIR=%h/.local/state/freelancebot/logs
Environment=LOG_MAX_BYTES=10485760
Environment=LOG_MAX_FILES=30
ExecStart=/absolute/path/to/node --import tsx scripts/capture-logs.ts
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
